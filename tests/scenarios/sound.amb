# the sound pages: a layer's button again; the knobs relative to the voice (0); back; kept by the piece
listen
wait 3000
tap ENV
wait 300
tap ENV
wait 400
said Chord voice page, voice Saws: Attack 0, Decay 25
expect view 8
# (format 36, the user's) ENV a third time: the Chord filter page (Cutoff, Reso, Env, Env decay)
tap ENV
wait 400
said Chord filter page, voice Saws: Cutoff 0, Reso 0, Env -25, Env decay +31
expect view 31
spin K2 -100
wait 200
expect par38 -50
said Reso -50
tap ENV
wait 300
expect view 12
# (1.4.0, the user's: Colour on the Chord FM page, every voice's)
spin K4 32
wait 200
expect par37 30
said Colour +30
turn ALGO 1
wait 300
said VOICE Keys
expect par37 30
tap ENV
wait 300
expect view 22
tap ENV
wait 300
expect view 1
tap SEQ
wait 200
tap SEQ
wait 300
expect view 11
spin K1 7
wait 200
expect par48 5
said Tune +5
tap ARP
wait 300
expect view 2
wait 6000
expect peak_db_max -0.5
# the piece keeps them; the reset puts them back to 0
turn PRESET 1
wait 400
turn PRESET -1
wait 400
expect par37 30
expect par48 5
press GLO
wait 1700
release GLO
wait 300
expect par37 0
expect par48 0
# FX again: the Echo page (Blur, Tone, Size, Cloud: 1.4.0, the space together; Width on the Form page); again, back to
# Dub (the Space page that was)
tap FX
wait 300
expect view 5
tap FX
wait 300
expect view 20
said Echo page: Blur 25, Tone 50, Size 
spin K1 -20
wait 300
said Blur 5
expect par117 5
tap FX
wait 300
expect view 5
